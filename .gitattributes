# Нормализация переводов строк: в репозитории — LF, как на сервере Linux.
* text=auto eol=lf

*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf

# Бинарные файлы
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
