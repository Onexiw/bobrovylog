# It's not recommended to modify this file in-place, because it
# will be overwritten during upgrades.  If you want to customize,
# the best way is to use the "systemctl edit" command.

[Unit]
Description=PHP 8.3.36 FastCGI Process Manager (new, test pool)
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/opt/remi/php83/sysconfig/php-fpm
ExecStart=/opt/php-8.3.36/sbin/php-fpm --nodaemonize --fpm-config /opt/php-8.3.36/etc/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
PrivateTmp=true

[Install]
WantedBy=multi-user.target

